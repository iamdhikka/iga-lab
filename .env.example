# Salin menjadi .env lalu ganti semua password dan secret.
# Password AD wajib kompleks: minimal 8 karakter, ada huruf besar, kecil, angka, dan simbol.

# Jangan ubah AD_REALM/AD_DOMAIN kecuali Anda juga mengubah alias jaringan di docker-compose.yml
AD_REALM=CORP.LAB
AD_DOMAIN=CORP

AD_ADMIN_PASSWORD=Ganti!Admin-2026
IGA_SERVICE_PASSWORD=Ganti!Svc-Iga-2026

# MySQL (database portal). Workbench/Grafana di laptop: host 127.0.0.1, port 3307.
MYSQL_ROOT_PASSWORD=Ganti!Root-2026
# Dipakai portal (baca/tulis data di database iga saja)
MYSQL_APP_PASSWORD=Ganti!App-2026
# Akun hanya-baca untuk MySQL Workbench, Grafana, atau auditor
MYSQL_READER_PASSWORD=Ganti!Reader-2026

# Kunci untuk menandatangani sesi login portal. Isi dengan string acak panjang, misalnya hasil:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
IGA_SECRET_KEY=ganti-dengan-string-acak-panjang

# Password awal akun karyawan baru (lab). Persona demo memakai password ini.
IGA_INITIAL_PASSWORD=Welc0me!Lab-2026
# Lab: false agar persona bisa langsung login. Produksi: true (wajib ganti password saat login pertama).
IGA_FORCE_PASSWORD_CHANGE=false
# Isi organisasi demo saat pertama kali dijalankan
IGA_SEED_DEMO=true
IGA_TIMEZONE=Asia/Jakarta

# Opsional: notifikasi alert critical/high ke Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
